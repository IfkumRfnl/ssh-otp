# Musl ABI grounding: main.zig's handwritten c_ulong rlimit and c_long timespec
# match x86_64, but not 32-bit musl (64-bit rlim_t/time_t and time64 redirects).
# Import libc declarations rather than assuming those layouts on 32-bit.
https://git.musl-libc.org/cgit/musl/plain/include/sys/resource.h
https://git.musl-libc.org/cgit/musl/plain/include/alltypes.h.in
# explicit_bzero used by pam.zig exists in musl; it is not glibc-only.
https://git.musl-libc.org/cgit/musl/plain/src/string/explicit_bzero.c
